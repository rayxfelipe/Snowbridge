SNOWBRIDGE_ENVIRONMENT=development
SNOWBRIDGE_SNOWFLAKE_BACKEND=mock
SNOWBRIDGE_AI_BACKEND=mock

# Required only after switching to the Microsoft Foundry AI backend.
# SNOWBRIDGE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/
# SNOWBRIDGE_FOUNDRY_DEPLOYMENT=gpt-4.1-mini
# SNOWBRIDGE_FOUNDRY_API_VERSION=2025-04-01-preview
# Prefer Microsoft Entra authentication. For local-only testing, an API key is also supported.
# SNOWBRIDGE_FOUNDRY_API_KEY=

# Required only after switching to the real Snowflake backend.
# SNOWBRIDGE_SNOWFLAKE_ACCOUNT=organization-account
# SNOWBRIDGE_SNOWFLAKE_USER=SNOWBRIDGE_USER
# SNOWBRIDGE_SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8
# SNOWBRIDGE_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWBRIDGE_SNOWFLAKE_WAREHOUSE=SNOWBRIDGE_WH
# SNOWBRIDGE_SNOWFLAKE_DATABASE=SNOWBRIDGE_DB
# SNOWBRIDGE_SNOWFLAKE_SCHEMA=PUBLIC
# SNOWBRIDGE_SNOWFLAKE_ROLE=SNOWBRIDGE_ROLE
